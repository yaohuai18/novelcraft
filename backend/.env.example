APP_NAME=NovelCraft
# 注意：正式使用必须设 DEBUG=false。
# DEBUG=true 且 EXPERIMENTAL_OPEN_IN_DEBUG=true 时，实验接口对普通登录用户放行（安全风险）。
DEBUG=true
# SQL 语句与绑定参数是否写入日志；默认关闭，排查 SQL 时再临时设为 true
SQL_ECHO=false

DATABASE_URL=sqlite+aiosqlite:///./novelcraft.db
JWT_SECRET_KEY=change-me-to-a-random-secret
# 支付回调验签密钥：必须显式配置强随机串，留空则所有支付回调一律拒绝（fail closed）
BILLING_PROVIDER_SECRET=
# 逗号分隔的模块黑名单，例如 enterprise,billing；留空则全部启用
DISABLED_MODULES=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- AI 配置（小说自动生成，优先级：DEEPSEEK_* > AI_* > OPENAI_*） ----
# 1) 复制本文件为 .env：cp .env.example .env（Windows: copy .env.example .env）
# 2) 填入真实密钥（DeepSeek 控制台申请）：sk-xxxxx
# 3) 默认模型地址与模型名无需修改；如需切换其他 OpenAI 兼容服务，
#    修改 AI_BASE_URL / AI_MODEL 即可（URL 兼容带不带 /v1 后缀）。
#    阶段 1 起：新任务的实际请求模型不再由 AI_MODEL 决定，而是由服务端唯一
#    策略表 app/services/model_policy.py 按任务类型集中分流：
#      · 章节正文 / 通用对话      -> deepseek-v4-pro（thinking=disabled，温度 0.9 / 0.7）
#      · 大纲规划 / 审校 / 事实抽取 / 修复候选 -> deepseek-v4-pro（thinking=enabled，reasoning_effort=high）
#      · 深度逻辑审校             -> deepseek-v4-pro（thinking=enabled，reasoning_effort=max）
#      · 章节摘要 / 分类打标      -> deepseek-flash（thinking=disabled，可 JSON 输出）
#    旧模型名（deepseek-chat / deepseek-reasoner）只作兼容映射，绝不作为真实请求模型下发。
#    AI_MODEL 仅在「未声明任务类型的旧调用路径」中作为兼容回退值使用。
DEEPSEEK_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 可选兼容变量（优先级低于 DEEPSEEK_* 与 AI_*）：
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 模型调用超时（秒）与单章最大输出 token
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=4000
# mock 模式逐章延迟（秒），便于前端展示进度
AI_MOCK_DELAY_SECONDS=0.6
